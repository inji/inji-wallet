<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Ios Test Suite" parallel="methods" thread-count="1">
    <listeners>
         <listener class-name="inji.utils.KnownIssueInvocationListener" />
         <listener class-name="inji.utils.KnownIssueMethodInterceptor" />
         <listener class-name="inji.utils.ThreadCountListener" />
         <listener class-name="inji.utils.BrowserStackStatusListener" />
    </listeners>
    <!-- Ios Tests -->
    <test verbose="2" preserve-order="true" name="ios">
         <classes>
           <class name="inji.testcases.iosTestCases.sanityFlows.FarmerFlowSanityTest">
             <methods>
               <include name="should_download_and_delete_farmer_vc_when_farmer_issuer_flow_completes" />
             </methods>
           </class>
           <class name="inji.testcases.iosTestCases.sanityFlows.LandFlowSanityTest">
             <methods>
               <include name="should_download_and_delete_land_vc_when_land_issuer_flow_completes" />
             </methods>
           </class>
           <class name="inji.testcases.iosTestCases.sanityFlows.MdlFlowSanityTest">
             <methods>
               <include name="should_download_and_delete_mdl_vc_when_mdl_issuer_flow_completes"/>
             </methods>
           </class>
               <class name="inji.testcases.iosTestCases.sanityFlows.MockFlowSanityTest">
                 <methods>
                   <include name="should_download_and_delete_mock_vc_when_mock_issuer_flow_completes" />
                 </methods>
               </class>
               <class name="inji.testcases.iosTestCases.sanityFlows.HelpPageAndAboutPageTest">
                 <methods>
                   <include name="should_show_help_and_about_pages_when_user_opens_help_and_settings"/>
                 </methods>
               </class>
               <class name="inji.testcases.iosTestCases.sanityFlows.ShareCardSanityTest">
                 <methods>
                   <include name="should_share_vc_when_camera_permission_is_granted" />
                 </methods>
               </class>
               <class name="inji.testcases.iosTestCases.sanityFlows.NoNetworkFlowSanityTest">
                 <methods>
                   <include name="should_not_show_issuer_options_when_internet_is_unavailable" />
                 </methods>
               </class>
        </classes>
    </test>
</suite>
